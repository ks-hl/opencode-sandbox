{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "share": "disabled",
  "permission": {
    "edit": "allow",
    "external_directory": {
      "*": "deny",
      "/tmp/opencode/*": "allow"
    },
    "bash": {
      "*": "allow",
      "git add*": "deny",
      "git commit*": "deny",
      "git push*": "deny",
      "git reset*": "deny",
      "git rebase*": "deny",
      "git checkout*": "deny",
      "git switch*": "deny",
      "git stash*": "deny",
      "git clean*": "deny",
      "rm -rf*": "deny"
    }
  },
  "agent": {
    "general": {
      "disable": true
    },
    "explore": {
      "disable": true
    }
  }
}
