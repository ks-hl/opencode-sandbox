#!/usr/bin/env bash
# Usage: oc-chat [opencode args...]
# Runs OpenCode in the opencode-sandbox image with no project or git mounts.
# Only ~/.opencode-docker (config, login, sessions, cache) is shared with the host.
# The global AGENTS.md is masked with an empty file so the worktree rules don't apply.
set -euo pipefail

OC_HOME="$HOME/.opencode-docker"
mkdir -p "$OC_HOME"/{config,share,state,cache}
: > "$OC_HOME/empty.md"

exec docker run --rm -it \
  --user "$(id -u):$(id -g)" \
  --cap-drop ALL \
  --security-opt no-new-privileges \
  -e HOME=/home/oc \
  -e TERM="${TERM:-xterm-256color}" \
  -e COLORTERM="${COLORTERM:-truecolor}" \
  -e LANG=C.UTF-8 \
  -v "$OC_HOME/config":/home/oc/.config/opencode \
  -v "$OC_HOME/empty.md":/home/oc/.config/opencode/AGENTS.md:ro \
  -v "$OC_HOME/share":/home/oc/.local/share/opencode \
  -v "$OC_HOME/state":/home/oc/.local/state/opencode \
  -v "$OC_HOME/cache":/home/oc/.cache/opencode \
  -w /tmp \
  opencode-sandbox opencode "$@"
